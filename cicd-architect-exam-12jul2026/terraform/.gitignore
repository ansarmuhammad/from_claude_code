# Local .terraform directories (provider plugins, module cache)
**/.terraform/*

# .tfstate files - state lives in the remote S3 backend, never commit local copies
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Local-only override files (may contain secrets/local overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files that may contain credentials
.terraformrc
terraform.rc

# Local variable files that may hold secrets - only terraform.tfvars (example
# values checked into this repo) is intentionally tracked.
*.auto.tfvars
*.auto.tfvars.json
